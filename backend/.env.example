# Строка подключения к PostgreSQL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/wordauction

# JWT: секрет не короче 32 байт, время жизни токена в минутах.
JWT_SECRET=change-me-in-production-very-long-secret-key-please-1234567890
JWT_EXPIRATION_MINUTES=1440

# Параметры игры по умолчанию.
GAME_LETTERS_PER_AUCTION=16
GAME_AUCTION_SECONDS=10
GAME_BUILD_TIMEOUT_SECONDS=40
GAME_RESULTS_SECONDS=15

# Разрешённые источники CORS в виде списка JSON.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
